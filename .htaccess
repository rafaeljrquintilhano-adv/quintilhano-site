# A home institucional esta em index.html.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normaliza acessos antigos/com maiuscula para a URL publica desejada.
  RewriteCond %{THE_REQUEST} \s/+Prev(?:/index\.html)?/?(?:[?\s])
  RewriteRule ^Prev(?:/index\.html)?/?$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev(?:[?\s]) [NC]
  RewriteRule ^prev$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev/index\.html[\s?] [NC]
  RewriteRule ^prev/index\.html$ /prev/ [R=301,L,NE]

  # A landing e todos os seus recursos sao estaticos e independentes do
  # WordPress. Isso mantem CSS, JavaScript e imagens funcionando em /prev/.
  RewriteRule ^prev/?$ landing-pages/auxilio-acidente/index.html [L]
  RewriteRule ^prev/(.+)$ landing-pages/auxilio-acidente/$1 [L]
</IfModule>
