# A home institucional esta em index.html.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normaliza acessos antigos/com maiuscula para a URL publica desejada.
  RewriteCond %{THE_REQUEST} \s/+Prev(?:/index\.html)?/?(?:[?\s])
  RewriteRule ^Prev(?:/index\.html)?/?$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev(?:[?\s]) [NC]
  RewriteRule ^prev$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev/index\.html[\s?] [NC]
  RewriteRule ^prev/index\.html$ /prev/ [R=301,L,NE]

  # A landing previdenciaria oficial esta na pasta "Prev". A URL publica
  # permanece em minusculas e todos os recursos sao resolvidos nessa pasta.
  RewriteRule ^prev/?$ Prev/index.html [L]
  RewriteRule ^prev/(.+)$ Prev/$1 [L]
</IfModule>
