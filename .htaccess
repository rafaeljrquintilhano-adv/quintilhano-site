# A home institucional esta em index.html.
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redireciona para HTTPS e remove o www, mantendo a URL canonica do site.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\..* [NC]
  RewriteRule ^ https://quintilhano.com%{REQUEST_URI} [R=301,L,NE]

  # Normaliza acessos antigos/com maiuscula para a URL publica desejada.
  RewriteCond %{THE_REQUEST} \s/+Prev(?:/index\.html)?/?(?:[?\s]) [NC]
  RewriteRule ^Prev(?:/index\.html)?/?$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev(?:[?\s]) [NC]
  RewriteRule ^prev$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev/index\.html[\s?] [NC]
  RewriteRule ^prev/index\.html$ /prev/ [R=301,L,NE]

  # Compatibilidade para recursos solicitados por versoes antigas/cacheadas da
  # landing em /prev/.
  RewriteRule ^prev/assets/(.+)$ landing-pages/auxilio-acidente/assets/$1 [L]
  RewriteRule ^prev/script\.js$ landing-pages/auxilio-acidente/script.js [L]
  RewriteRule ^prev/styles\.css$ assets/css/landing-pages/auxilio-acidente.css [L]
</IfModule>
