# A home institucional esta em index.html.
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Evita redirecionamento de arquivos de indexacao e sitemap, para nao quebrar
  # o acesso do Google Search Console e dos crawlers.
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]

  # Redireciona para HTTPS e remove o www, mantendo a URL canonica do site.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\..* [NC]
  RewriteRule ^ https://quintilhano.com%{REQUEST_URI} [R=301,L,NE]

  # Normaliza acessos antigos/com maiuscula para a URL publica desejada.
  RewriteCond %{THE_REQUEST} \s/+Prev(?:/index\.html)?/?(?:[?\s]) [NC]
  RewriteRule ^Prev(?:/index\.html)?/?$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev(?:[?\s]) [NC]
  RewriteRule ^prev$ /prev/ [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+prev/index\.html[\s?] [NC]
  RewriteRule ^prev/index\.html$ /prev/ [R=301,L,NE]

  # Enderecos antigos do WordPress que o Google ainda conhece.
  RewriteRule ^(?:.+/)?privacy-policy/?$ /politica-de-privacidade.html [R=301,L,NE]
  RewriteRule ^teve-seu-beneficio-negado-ou-nao-sabe-se-ja-pode-se-aposentar-descubra-quais-sao-os-seus-direitos/?$ /atuacao/previdenciario.html [R=301,L,NE]
  RewriteRule ^elementor-[0-9]+/?$ - [G,L]

  # Imagens antigas substituidas por versoes otimizadas (WebP).
  RewriteRule ^(?:landing-pages/auxilio-acidente|prev)/assets/(1|2|3|4|5|11|22|33|44|55)\.png$ /landing-pages/auxilio-acidente/assets/$1.webp [R=301,L,NE]
  RewriteRule ^img/Advogados/F.+bio\.png$ /img/equipe/fabio.webp [R=301,L,NE]
  RewriteRule ^img/Advogados/Thais\.png$ /img/equipe/thais.webp [R=301,L,NE]
  RewriteRule ^img/Advogados/Gabriella\.png$ /img/equipe/gabriella.webp [R=301,L,NE]
  RewriteRule ^img/Advogados/Alice\.jpg$ /img/equipe/alice.webp [R=301,L,NE]
  RewriteRule ^img/Pr.+dio\ Sede\.png$ /img/predio-sede.webp [R=301,L,NE]
  RewriteRule ^img/Plano\ de\ fundo-Home-Site\.jpg$ /img/plano-de-fundo.webp [R=301,L,NE]

  # Remove do ar a copia antiga do WordPress.
  RewriteRule ^legacy(?:/.*)?$ - [G,L]

  # Compatibilidade para recursos solicitados por versoes antigas/cacheadas da
  # landing em /prev/.
  RewriteRule ^prev/assets/(.+)$ landing-pages/auxilio-acidente/assets/$1 [L]
  RewriteRule ^prev/script\.js$ landing-pages/auxilio-acidente/script.js [L]
  RewriteRule ^prev/styles\.css$ assets/css/landing-pages/auxilio-acidente.css [L]
</IfModule>
